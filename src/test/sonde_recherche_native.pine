//@version=6
// Sonde d'une minute pour BSP test3 : vérifie sur TradingView que
// array.binary_search_leftmost / rightmost renvoient bien la première /
// dernière occurrence d'une valeur répétée, et le bon voisin quand la valeur
// est absente. Coller dans l'éditeur Pine, ajouter au graphique, lire
// l'étiquette sur la dernière bougie : « OK » ou « ÉCART ». Puis la retirer.
indicator("Sonde recherche native", overlay = true)

a = array.from(10, 20, 20, 20, 30, 40)
int l15 = array.binary_search_leftmost(a, 15)
int l20 = array.binary_search_leftmost(a, 20)
int l25 = array.binary_search_leftmost(a, 25)
int r15 = array.binary_search_rightmost(a, 15)
int r20 = array.binary_search_rightmost(a, 20)
int r25 = array.binary_search_rightmost(a, 25)

b = array.from(5, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 9)
int lb = array.binary_search_leftmost(b, 7)
int rb = array.binary_search_rightmost(b, 7)

bool ok = l15 == 0 and l20 == 1 and l25 == 3 and r15 == 1 and r20 == 3 and r25 == 4 and lb == 1 and rb == 10

if barstate.islast
    string txt = (ok ? "OK" : "ÉCART") + "\nleftmost 15 / 20 / 25 : " + str.tostring(l15) + " " + str.tostring(l20) + " " + str.tostring(l25) + "   (attendu 0 1 3)" + "\nrightmost 15 / 20 / 25 : " + str.tostring(r15) + " " + str.tostring(r20) + " " + str.tostring(r25) + "   (attendu 1 3 4)" + "\nsérie de 7 : " + str.tostring(lb) + " " + str.tostring(rb) + "   (attendu 1 10)"
    label.new(bar_index, high, txt, color = ok ? color.green : color.red, textcolor = color.white, style = label.style_label_down)
