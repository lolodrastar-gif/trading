//@version=6
indicator("LOLO 2 - Filtre CHOP/ATR (TEST v0.1)", "L2 FILTRE", overlay = true)

// Tableau de CONTEXTE, pas un signal d'achat/vente.
// Concu pour une UT temporelle (essai initial : NAS100 en 1 minute).
// Les seuils sont experimentaux ; verifier leur utilite sur les trades historiques.

// --- PARAMETRES ---
int chopLen = input.int(14, "CHOP - periode", minval = 2, group = "Marche")
int atrLen = input.int(14, "ATR - periode", minval = 2, group = "Marche")
float stopPts = input.float(20.0, "Stop de reference (points NAS)", minval = 0.1, step = 0.5, group = "Risque")
float chopGreen = input.float(38.2, "CHOP favorable sous", minval = 0, maxval = 100, group = "Seuils TEST")
float chopRed = input.float(61.8, "CHOP dangereux des", minval = 0, maxval = 100, group = "Seuils TEST")
float atrOrange = input.float(0.70, "ATR / stop - vigilance des", minval = 0.1, step = 0.05, group = "Seuils TEST")
float atrRed = input.float(1.00, "ATR / stop - danger des", minval = 0.1, step = 0.05, group = "Seuils TEST")

// --- CALCULS SIMPLES, SUR CHAQUE BOUGIE ---
// CHOP = 100 * log10(somme des True Ranges / plage High-Low) / log10(N).
float trSum = math.sum(ta.tr(true), chopLen)
float highestPrice = ta.highest(high, chopLen)
float lowestPrice = ta.lowest(low, chopLen)
float priceRange = highestPrice - lowestPrice
float chop = bar_index >= chopLen - 1 and priceRange > 0 and trSum > 0 ? 100.0 * math.log10(trSum / priceRange) / math.log10(chopLen) : na
float atrPts = ta.atr(atrLen)
float atrToStop = atrPts / stopPts

bool ready = not na(chop) and not na(atrToStop)
bool highChop = ready and chop >= chopRed
bool highAtr = ready and atrToStop >= atrRed
bool blocked = highChop or highAtr
bool favorable = ready and not blocked and chop < chopGreen and atrToStop < atrOrange

string verdict = not ready ? "DONNEES..." : blocked ? "ROUGE - STOP" : favorable ? "VERT - ETUDIER" : "ORANGE - ATTENDRE"
string cause = not ready ? "Historique insuffisant" : highChop and highAtr ? "CHOP + ATR" : highChop ? "Marche hache" : highAtr ? "ATR trop eleve" : favorable ? "Contexte a examiner" : "Conditions mixtes"
color verdictColor = not ready ? color.gray : blocked ? color.rgb(150, 40, 50) : favorable ? color.rgb(15, 105, 70) : color.rgb(160, 105, 20)
color bgHeader = color.rgb(35, 42, 52)
color bgCell = color.rgb(45, 51, 60)

// --- UN SEUL TABLEAU : cree une fois et actualise a la cloture ---
// Pas d'objets accumules, pas de request.security, pas de boucle, pas de recalcul intrabar du tableau.
var table dashboard = table.new(position.top_right, 2, 6, frame_color = color.gray, frame_width = 1, border_width = 1)
bool refresh = barstate.islastconfirmedhistory or (barstate.islast and barstate.isconfirmed)
if refresh
    table.cell(dashboard, 0, 0, "LOLO 2 / FILTRE", bgcolor = bgHeader, text_color = color.white, text_size = size.small)
    table.cell(dashboard, 1, 0, "UT " + timeframe.period, bgcolor = bgHeader, text_color = color.white, text_size = size.small)
    table.cell(dashboard, 0, 1, "CHOP " + str.tostring(chopLen), bgcolor = bgCell, text_color = color.white)
    table.cell(dashboard, 1, 1, ready ? str.tostring(chop, "#.0") : "--", bgcolor = bgCell, text_color = color.white)
    table.cell(dashboard, 0, 2, "ATR " + str.tostring(atrLen), bgcolor = bgCell, text_color = color.white)
    table.cell(dashboard, 1, 2, ready ? str.tostring(atrPts, "#.1") + " pts" : "--", bgcolor = bgCell, text_color = color.white)
    table.cell(dashboard, 0, 3, "STOP REPERE", bgcolor = bgCell, text_color = color.white)
    table.cell(dashboard, 1, 3, str.tostring(stopPts, "#.1") + " pts", bgcolor = bgCell, text_color = color.white)
    table.cell(dashboard, 0, 4, "ATR / STOP", bgcolor = bgCell, text_color = color.white)
    table.cell(dashboard, 1, 4, ready ? str.tostring(atrToStop * 100.0, "#.0") + " %" : "--", bgcolor = bgCell, text_color = color.white)
    table.cell(dashboard, 0, 5, cause, bgcolor = verdictColor, text_color = color.white)
    table.cell(dashboard, 1, 5, verdict, bgcolor = verdictColor, text_color = color.white)
