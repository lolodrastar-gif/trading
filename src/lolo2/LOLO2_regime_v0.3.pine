//@version=6
// LOLO 2 - REGIME TENDANCE v0.2 / TABLEAU SEUL
// Calculs identiques a la version v0.1 : EMA + pente ATR + DMI/ADX + Kaufman ER.
// Affiche seulement le tableau sur le graphique. Aucune etiquette ni courbe de prix.
// Etats confirmes en cloture. Aucun signal d'entree.
indicator("LOLO 2 - Regime v0.3 TABLEAU REGLABLE", shorttitle="L2 REG TABLE v0.3", overlay=true, precision=2)

const string G_D = "1. Sens de la tendance"
int fastLen = input.int(21, "EMA rapide", minval=2, maxval=300, group=G_D)
int slowLen = input.int(55, "EMA lente", minval=5, maxval=500, group=G_D)
int slopeBars = input.int(5, "Pente EMA lente : nombre de bougies", minval=1, maxval=100, group=G_D)
int atrLen = input.int(14, "ATR pour normaliser la pente", minval=2, maxval=100, group=G_D)
float minSlopeAtr = input.float(0.12, "Pente minimale (en ATR)", minval=0.0, maxval=5.0, step=0.02, group=G_D)

const string G_Q = "2. Qualite du mouvement"
int diLen = input.int(14, "DMI : periode", minval=2, maxval=100, group=G_Q)
int adxSmooth = input.int(14, "ADX : lissage", minval=2, maxval=100, group=G_Q)
float minAdx = input.float(25.0, "ADX minimum", minval=5.0, maxval=60.0, step=1.0, group=G_Q)
int erLen = input.int(20, "Kaufman ER : periode", minval=3, maxval=150, group=G_Q)
float minEr = input.float(0.25, "ER minimum (0 a 1)", minval=0.0, maxval=1.0, step=0.05, group=G_Q)

const string G_C = "3. Confirmation et stabilite"
int enterBars = input.int(2, "Clotures consecutives pour entrer en tendance", minval=1, maxval=10, group=G_C)
int exitBars = input.int(2, "Clotures insuffisantes pour revenir a NEUTRE", minval=1, maxval=10, group=G_C)

// Affichage uniquement : taille et emplacement du tableau.
const string G_T = "4. Affichage du tableau"
string tailleTableau = input.string("Moyen", "Taille", options=["Petit", "Moyen", "Grand"], group=G_T)
string positionTableau = input.string("Haut droite", "Position", options=["Haut gauche", "Haut centre", "Haut droite", "Milieu gauche", "Milieu centre", "Milieu droite", "Bas gauche", "Bas centre", "Bas droite"], group=G_T)

// Ces choix n'interviennent jamais dans les calculs de tendance.
positionChoisie = switch positionTableau
    "Haut gauche" => position.top_left
    "Haut centre" => position.top_center
    "Haut droite" => position.top_right
    "Milieu gauche" => position.middle_left
    "Milieu centre" => position.middle_center
    "Milieu droite" => position.middle_right
    "Bas gauche" => position.bottom_left
    "Bas centre" => position.bottom_center
    => position.bottom_right

tailleChoisie = switch tailleTableau
    "Petit" => size.small
    "Moyen" => size.normal
    => size.large

// Toutes les series sont calculees sur CHAQUE bougie.
float emaFast = ta.ema(close, fastLen)
float emaSlow = ta.ema(close, slowLen)
float atrV = ta.atr(atrLen)
[diPlus, diMinus, adxV] = ta.dmi(diLen, adxSmooth)

// Ratio d'efficacite de Perry Kaufman : deplacement net / trajet total.
float stepDistance = math.abs(ta.change(close))
float totalDistance = math.sum(stepDistance, erLen)
float netDistance = math.abs(close - close[erLen])
float erV = not na(close[erLen]) and not na(totalDistance) and totalDistance > 0.0 ? netDistance / totalDistance : 0.0

// Comparaison de la pente a l'ATR : seuil moins dependant du prix nominal.
float slope = emaSlow - emaSlow[slopeBars]
float slopeAtr = not na(atrV) and atrV > 0 and not na(slope) ? slope / atrV : na
bool ready = bar_index >= math.max(slowLen + slopeBars, erLen + diLen + adxSmooth) and not na(adxV) and not na(slopeAtr) and not na(emaFast)

bool directionalUp = emaFast > emaSlow and close > emaFast and slopeAtr >= minSlopeAtr and diPlus > diMinus
bool directionalDown = emaFast < emaSlow and close < emaFast and slopeAtr <= -minSlopeAtr and diMinus > diPlus
bool qualityOK = adxV >= minAdx and erV >= minEr
bool upCandidate = ready and directionalUp and qualityOK
bool downCandidate = ready and directionalDown and qualityOK

// Hysteresis simple : 2 bougies de validation par defaut pour entrer et sortir.
// Une inversion doit passer par NEUTRE : jamais de retournement force intrabougie.
var int regime = 0           // +1=HAUSSIER, -1=BAISSIER, 0=NEUTRE
var int upStreak = 0
var int downStreak = 0
var int failStreak = 0
var string confirmedHint = "Initialisation"

if barstate.isconfirmed
    upStreak := upCandidate ? upStreak + 1 : 0
    downStreak := downCandidate ? downStreak + 1 : 0

    if not ready
        regime := 0
        failStreak := 0
    else if regime == 0
        failStreak := 0
        if upStreak >= enterBars
            regime := 1
        else if downStreak >= enterBars
            regime := -1
    else if regime == 1
        failStreak := upCandidate ? 0 : failStreak + 1
        if failStreak >= exitBars
            regime := 0
            failStreak := 0
    else
        failStreak := downCandidate ? 0 : failStreak + 1
        if failStreak >= exitBars
            regime := 0
            failStreak := 0

    // Diagnostic memorise uniquement a la cloture, comme le regime.
    confirmedHint := not ready ? "Initialisation" : regime == 1 and not upCandidate ? "Hausse a revalider" : regime == -1 and not downCandidate ? "Baisse a revalider" : qualityOK ? "Qualite OK" : "Qualite insuffisante"

bool becameUp = barstate.isconfirmed and regime == 1 and nz(regime[1], 0) != 1
bool becameDown = barstate.isconfirmed and regime == -1 and nz(regime[1], 0) != -1
bool becameNeutral = barstate.isconfirmed and regime == 0 and nz(regime[1], 0) != 0


// -------- AFFICHAGE : tableau seul, sans trace sur le prix --------
color upColor = color.rgb(37, 173, 111)
color downColor = color.rgb(215, 79, 87)
color neutralColor = color.rgb(145, 150, 166)
color regimeColor = regime == 1 ? upColor : regime == -1 ? downColor : neutralColor
string regimeText = regime == 1 ? "HAUSSIER" : regime == -1 ? "BAISSIER" : "NEUTRE"

var table panel = table.new(positionChoisie, 2, 5, border_width=1)
float adxShown = barstate.isconfirmed ? adxV : adxV[1]
float erShown = barstate.isconfirmed ? erV : erV[1]
float slopeShown = barstate.isconfirmed ? slopeAtr : slopeAtr[1]
if barstate.islast
    table.cell(panel, 0, 0, "LOLO 2 / TENDANCE", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=tailleChoisie)
    table.cell(panel, 1, 0, regimeText, text_color=color.white, bgcolor=regimeColor, text_size=tailleChoisie)
    table.cell(panel, 0, 1, "ADX / seuil", text_color=color.white, bgcolor=color.new(color.black, 35), text_size=tailleChoisie)
    table.cell(panel, 1, 1, str.tostring(adxShown, "#.0") + " / " + str.tostring(minAdx, "#.0"), text_color=color.white, bgcolor=color.new(color.black, 35), text_size=tailleChoisie)
    table.cell(panel, 0, 2, "ER / seuil", text_color=color.white, bgcolor=color.new(color.black, 35), text_size=tailleChoisie)
    table.cell(panel, 1, 2, str.tostring(erShown, "#.00") + " / " + str.tostring(minEr, "#.00"), text_color=color.white, bgcolor=color.new(color.black, 35), text_size=tailleChoisie)
    table.cell(panel, 0, 3, "Pente EMA / ATR", text_color=color.white, bgcolor=color.new(color.black, 35), text_size=tailleChoisie)
    table.cell(panel, 1, 3, str.tostring(slopeShown, "#.00"), text_color=color.white, bgcolor=color.new(color.black, 35), text_size=tailleChoisie)
    table.cell(panel, 0, 4, "Diagnostic", text_color=color.white, bgcolor=color.new(color.black, 35), text_size=tailleChoisie)
    table.cell(panel, 1, 4, confirmedHint, text_color=color.white, bgcolor=color.new(color.black, 35), text_size=tailleChoisie)

plot(regime, title="Regime confirme (+1/0/-1)", display=display.data_window)
plot(adxV, title="ADX", display=display.data_window)
plot(erV, title="Kaufman ER", display=display.data_window)
plot(slopeAtr, title="Pente EMA lente / ATR", display=display.data_window)

alertcondition(becameUp, title="L2 regime HAUSSIER", message="L2 Regime HAUSSIER {{ticker}} {{interval}}")
alertcondition(becameDown, title="L2 regime BAISSIER", message="L2 Regime BAISSIER {{ticker}} {{interval}}")
alertcondition(becameNeutral, title="L2 regime NEUTRE", message="L2 Regime NEUTRE {{ticker}} {{interval}}")
